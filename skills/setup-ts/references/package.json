{
  "name": "project",
  "version": "0.0.0",
  "private": true,
  "description": "",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check:actions": "actionlint && zizmor --persona=pedantic .github/workflows",
    "check:fmt": "oxfmt --check",
    "check:lint": "oxlint",
    "check:md": "markdownlint-cli2 \"**/*.md\"",
    "check:package": "run-s build && publint --strict && attw --pack . --profile esm-only",
    "check:quality": "fallow --fail-on-issues --quiet",
    "check:security": "fallow security",
    "check:spelling": "cspell --no-progress --no-must-find-files \"**/*.{ts,tsx,mts,cts,md}\"",
    "check:static": "run-s -c check:lint check:md check:fmt check:actions check:typelint check:spelling check:type",
    "check:type": "tsc -p tsconfig.json --noEmit",
    "check:typelint": "oxlint --type-aware",
    "check": "run-s -c check:static check:quality",
    "fix:fmt": "oxfmt",
    "fix:lint": "oxlint --fix",
    "fix:md": "markdownlint-cli2 --fix \"**/*.md\"",
    "fix:quality": "fallow fix --yes --no-create-config",
    "fix": "run-s fix:lint fix:md fix:fmt",
    "prepare": "test -d .git && lefthook install || true",
    "test": "vitest run --coverage"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.0",
    "@commitlint/cli": "^21.2.0",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/node": "^26.4.0",
    "@vitest/coverage-istanbul": "^4.1.0",
    "cspell": "^10.2.0",
    "fallow": "^3.21.0",
    "lefthook": "^2.1.0",
    "markdownlint-cli2": "^0.23.0",
    "npm-run-all2": "^9.0.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.0",
    "publint": "^0.3.0",
    "typescript": "^7.0.0",
    "vitest": "^4.1.0"
  },
  "overrides": {
    "markdownlint-cli2": {
      "js-yaml": "^5.2.2"
    }
  },
  "engines": {
    "node": ">=22"
  }
}
