{
  "name": "project",
  "version": "0.0.0",
  "private": true,
  "description": "",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "lefthook run check",
    "check:package": "npm run build && publint --strict && attw --pack . --profile esm-only",
    "check:security": "fallow security",
    "fix": "lefthook run check --commands lint,md,fmt && fallow fix --yes --no-create-config",
    "prepare": "test -d .git && lefthook install || true",
    "test": "vitest run --coverage"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.0",
    "@commitlint/cli": "^21.2.0",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/node": "^26.4.0",
    "@vitest/coverage-istanbul": "^4.1.0",
    "cspell": "^10.2.0",
    "fallow": "^3.21.0",
    "lefthook": "^2.1.0",
    "markdownlint-cli2": "^0.23.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.0",
    "publint": "^0.3.0",
    "typescript": "^7.0.0",
    "vitest": "^4.1.0"
  },
  "overrides": {
    "markdownlint-cli2": {
      "js-yaml": "^5.2.2"
    }
  },
  "engines": {
    "node": ">=22"
  }
}
