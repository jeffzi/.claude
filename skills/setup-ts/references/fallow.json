{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": ["src/index.ts"],
  "ignoreExportsUsedInFile": true,
  "ignoreDependencies": [
    "cspell",
    "fallow",
    "lefthook",
    "markdownlint-cli2",
    "oxfmt",
    "oxlint",
    "oxlint-tsgolint"
  ],
  "duplicates": { "ignore": ["tests/**"] },
  "rules": { "duplicate-exports": "off" },
  "health": {
    "thresholdOverrides": [
      {
        "files": ["tests/**/*.test.ts"],
        "functions": ["<arrow>"],
        "maxUnitSize": 800,
        "reason": "describe/it callbacks are suite containers; file length is capped by oxlint max-lines"
      }
    ],
    "coverage": "coverage/coverage-final.json"
  }
}
