{
  "env": {
    "CLAUDE_CODE_ENABLE_TELEMETRY": "0"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "includeCoAuthoredBy": false,
  "includeGitInstructions": false,
  "permissions": {
    "allow": [
      "Glob",
      "Grep",
      "Read",
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(awk *)",
      "Bash(cat *)",
      "Bash(jq *)",
      "Bash(ls *)",
      "Bash(mkdir *)",
      "Bash(sed *)",
      "Bash(shellcheck *)",
      "Bash(shfmt *)",
      "Bash(which *)",
      "Bash(prek *)",
      "Bash(task *)",
      "Bash(pytest *)",
      "Bash(ruff *)",
      "Bash(uv *)",
      "Bash(biome *)",
      "Bash(bun *)",
      "Bash(eslint *)",
      "Bash(node *)",
      "Bash(npm run *)",
      "Bash(npx *)",
      "Bash(tsc *)",
      "Bash(busted *)",
      "Bash(llscheck *)",
      "Bash(luacheck *)",
      "Bash(cargo *)",
      "Bash(swift *)",
      "Bash(swiftformat *)",
      "Bash(swiftlint *)",
      "Bash(~/.claude/scripts/fix-ci-push.sh *)",
      "Bash(ils push)"
    ],
    "ask": [
      "Bash(ils merge)",
      "Bash(ils merge *)",
      "Bash(ils release)",
      "Bash(ils release *)",
      "Bash(gh pr merge)",
      "Bash(gh pr merge *)",
      "Bash(gh release create)",
      "Bash(gh release create *)"
    ],
    "deny": [
      "Bash(git checkout *)",
      "Bash(git checkout)",
      "Bash(git clean *)",
      "Bash(git clean)",
      "Bash(git push *)",
      "Bash(git push)",
      "Bash(git reset *)",
      "Bash(git reset)",
      "Bash(git stash *)",
      "Bash(git stash)",
      "NotebookEdit"
    ],
    "defaultMode": "auto"
  },
  "model": "fable",
  "disableBundledSkills": true,
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/git-lock-guard.sh"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/git-guard.sh"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/git-commit-guard.sh",
            "if": "Bash(git commit*)"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/git-commit-guard.sh",
            "if": "Bash(gh pr create*)"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/git-commit-guard.sh",
            "if": "Bash(gh pr edit*)"
          }
        ]
      },
      {
        "matcher": "ExitWorktree",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/worktree-guard.sh"
          }
        ]
      },
      {
        "matcher": "Read|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/tdd-red-guard.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/bash-exit-guard.sh",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "disableWorkflows": true,
  "statusLine": {
    "type": "command",
    "command": "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/scripts/statusline.sh"
  },
  "enabledPlugins": {
    "lua-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true,
    "clangd-lsp@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    }
  },
  "outputStyle": "Terse",
  "feedbackDrafts": "off",
  "effortLevel": "medium",
  "modelSettings": {
    "fable": {
      "effortLevel": "high"
    },
    "opus": {
      "effortLevel": "medium"
    },
    "sonnet": {
      "effortLevel": "medium"
    },
    "claude-opus-4-6": {
      "effortLevel": "high"
    },
    "claude-fable-5-1": {
      "effortLevel": "xhigh"
    },
    "claude-opus-5": {
      "effortLevel": "high"
    },
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "medium"
    }
  },
  "promptSuggestionEnabled": false,
  "askUserQuestionTimeout": "never",
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "preferredNotifChannel": "terminal_bell",
  "autoCompactEnabled": true,
  "autoContinueAtUsageLimit": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "autoMode": {
    "soft_deny": [
      "$defaults",
      "Bash(uv run *:*prod*)",
      "Terraform apply/destroy within infrastructure/terraform/ (acm.tf, alb.tf, cognito.tf, security_groups.tf, vpc.tf, waf.tf) — protected IaC scope"
    ],
    "environment": [
      "### Org-wide",
      "**Organization**: None configured",
      "**Cloud provider(s)**: None configured",
      "**Repository visibility**: PUBLIC (jeffzi/gymrat, confirmed via gh) — any push there is publishing; only this repo's own work belongs there, no confidential or sensitive material",
      "**Internal sharing / snippet hosting**: None configured — treat public paste/gist services as outside the trust boundary",
      "**Secrets management**: None configured",
      "**Default / protected branches**: main (default branch, confirmed via gh); protected (gh reports `main` as a protected branch; no rulesets listed)",
      "**CI/CD deploy targets**: None configured",
      "**Network posture**: None configured",
      "**Host containment**: None configured — assume Claude Code runs on an ordinary developer machine or CI runner with open internet",
      "**Source control**: The trusted repo (jeffzi/gymrat via origin remote github.com:jeffzi/gymrat.git) and its remote(s) only — no additional orgs configured",
      "**Trusted internal domains**: None configured",
      "**Trusted cloud buckets**: None configured",
      "**Key internal services**: None configured",
      "**Internal package registry**: None configured",
      "**Sensitive data locations & audiences**: any file or store holding personal data, confidential business data, credentials, regulated data, or similarly sensitive material; preserve exact handles when known and share only with audiences cleared at the [named+specifics] bar. Repo has .gitignore patterns for `.env`, `.envrc` — treat matching files as sensitive",
      "**Data retention / declassification**: None configured",
      "**Sensitive remote targets**: any namespace, host, or container whose name carries `prod` or `production` as a whole word or name segment",
      "**Protected deployment namespaces / environments**: None configured — fall back to the Sensitive remote targets heuristic",
      "**Protected IaC scopes**: IAM, RBAC, networking, quota, and node-pool resources; anything whose name or tag carries `prod` or `production` as a whole word or name segment",
      "### User-specific",
      "**Primary use of Claude Code**: software development (Python CLI — statistical benchmark comparison tool)",
      "**Trusted repo**: /Users/jeffzi/Projects/personal/gymrat-py (working directory), remote origin at github.com:jeffzi/gymrat.git — PUBLIC; only this repo's own work belongs there, confidential/sensitive material never, and content ported from outside this repo is not its own work",
      "**Org-specific CLIs**: None configured"
    ]
  }
}
