{
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(busted *)",
      "Bash(cargo *)",
      "Bash(gh *)",
      "Bash(git *)",
      "Bash(ls *)",
      "Bash(llscheck *)",
      "Bash(luacheck *)",
      "Bash(mkdir *)",
      "Bash(mypy *)",
      "Bash(prek *)",
      "Bash(pytest *)",
      "Bash(ruff *)",
      "Bash(awk *)",
      "Bash(sed *)",
      "Bash(shellcheck *)",
      "Bash(shfmt *)",
      "Bash(task *)",
      "Bash(uv *)",
      "Bash(which *)",
      "Glob",
      "Grep",
      "Read"
    ],
    "deny": [
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git stash)",
      "Bash(git stash *)",
      "Bash(git clean)",
      "Bash(git clean *)",
      "Bash(git reset)",
      "Bash(git reset *)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/secrets/*)",
      "Read(**/*credential*)",
      "Read(**/*.pem)",
      "Read(**/*.key)"
    ],
    "defaultMode": "plan"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash(git *)",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/jeffzi/.claude/hooks/git-safety.sh"
          }
        ]
      },
      {
        "matcher": "Bash(git commit*)",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/jeffzi/.claude/hooks/marimo-check.sh"
          },
          {
            "type": "command",
            "command": "/Users/jeffzi/.claude/hooks/shiny-check.sh"
          }
        ]
      },
      {
        "matcher": "ExitWorktree",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/jeffzi/.claude/hooks/worktree-safety.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/jeffzi/.claude/hooks/skill-loader.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"/Users/jeffzi/.claude/hooks/gsd-check-update.js\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"/Users/jeffzi/.claude/hooks/gsd-context-monitor.js\""
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node \"/Users/jeffzi/.claude/hooks/gsd-statusline.js\""
  },
  "enabledPlugins": {
    "commit-commands@claude-plugins-official": true,
    "elements-of-style@superpowers-marketplace": true,
    "lua-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "scientific-skills@claude-scientific-skills": true,
    "superpowers-developing-for-claude-code@superpowers-marketplace": true,
    "superpowers@superpowers-marketplace": true,
    "typescript-lsp@claude-plugins-official": true,
    "superpowers-chrome@superpowers-marketplace": true,
    "skill-creator@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "superpowers-marketplace": {
      "source": {
        "source": "github",
        "repo": "obra/superpowers-marketplace"
      }
    },
    "claude-scientific-skills": {
      "source": {
        "source": "github",
        "repo": "K-Dense-AI/claude-scientific-skills"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "promptSuggestionEnabled": false,
  "skipDangerousModePermissionPrompt": true
}
