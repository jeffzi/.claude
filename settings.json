{
  "env": {
    "CLAUDE_CODE_ENABLE_TELEMETRY": "0",
    "MAX_THINKING_TOKENS": "10000",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "75",
    "CLAUDE_CODE_SUBAGENT_MODEL": "haiku"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Glob",
      "Grep",
      "Read",
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(awk *)",
      "Bash(cat *)",
      "Bash(jq *)",
      "Bash(ls *)",
      "Bash(mkdir *)",
      "Bash(sed *)",
      "Bash(shellcheck *)",
      "Bash(shfmt *)",
      "Bash(which *)",
      "Bash(prek *)",
      "Bash(task *)",
      "Bash(pytest *)",
      "Bash(ruff *)",
      "Bash(uv *)",
      "Bash(biome *)",
      "Bash(bun *)",
      "Bash(eslint *)",
      "Bash(node *)",
      "Bash(npm run *)",
      "Bash(npx *)",
      "Bash(tsc *)",
      "Bash(busted *)",
      "Bash(llscheck *)",
      "Bash(luacheck *)",
      "Bash(cargo *)",
      "Bash(swift *)",
      "Bash(swiftformat *)",
      "Bash(swiftlint *)"
    ],
    "deny": [
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git stash)",
      "Bash(git stash *)",
      "Bash(git clean)",
      "Bash(git clean *)",
      "Bash(git reset)",
      "Bash(git reset *)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/secrets/*)",
      "Read(**/*credential*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.secret)"
    ],
    "defaultMode": "auto"
  },
  "model": "fable",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash(git *)",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/git-lock-guard.sh"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/git-guard.sh"
          }
        ]
      },
      {
        "matcher": "Bash(git commit*)",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/git-commit-guard.sh"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/marimo-check.sh"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/shiny-check.sh"
          }
        ]
      },
      {
        "matcher": "ExitWorktree",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/worktree-guard.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/config-guard.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "EnterPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/plan-skill-guard.sh"
          }
        ]
      },
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/plan-claim-guard.sh"
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/read-once/hook.sh"
          }
        ]
      },
      {
        "matcher": "Read|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/tdd-red-guard.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [],
    "SessionStart": [],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/bash-exit-guard.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/read-once/compact.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "$HOME/.claude/scripts/statusline.sh"
  },
  "enabledPlugins": {
    "claude-md-management@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "clangd-lsp@claude-plugins-official": true,
    "ponytail@ponytail": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "effortLevel": "medium",
  "promptSuggestionEnabled": false,
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "autoCompactEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
}
