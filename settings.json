{
  "alwaysThinkingEnabled": true,
  "includeCoAuthoredBy": false,
  "enabledPlugins": {
    "commit-commands@claude-plugins-official": true,
    "elements-of-style@superpowers-marketplace": true,
    "lua-lsp@claude-plugins-official": false,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "scientific-skills@claude-scientific-skills": false,
    "superpowers-developing-for-claude-code@superpowers-marketplace": true,
    "superpowers@superpowers-marketplace": true,
    "typescript-lsp@claude-plugins-official": false
  },
  "permissions": {
    "allow": [
      "Bash(busted *)",
      "Bash(cargo *)",
      "Bash(gh *)",
      "Bash(git *)",
      "Bash(ls *)",
      "Bash(llscheck *)",
      "Bash(luacheck *)",
      "Bash(mkdir *)",
      "Bash(mypy *)",
      "Bash(prek *)",
      "Bash(pytest *)",
      "Bash(ruff *)",
      "Bash(awk *)",
      "Bash(sed *)",
      "Bash(shellcheck *)",
      "Bash(shfmt *)",
      "Bash(task *)",
      "Bash(uv *)",
      "Bash(which *)",
      "Glob",
      "Grep",
      "Read"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(git checkout:*)",
      "Bash(git clean:*)",
      "Bash(git reset --hard:*)",
      "Bash(git stash:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "/Users/jeffzi/.claude/hooks/git-safety.sh",
            "type": "command"
          }
        ],
        "matcher": "Bash(git *)"
      },
      {
        "hooks": [
          {
            "command": "/Users/jeffzi/.claude/hooks/marimo-check.sh",
            "type": "command"
          }
        ],
        "matcher": "Bash(git commit*)"
      }
    ]
  }
}
