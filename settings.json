{
  "env": {
    "CLAUDE_CODE_ENABLE_TELEMETRY": "0"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Glob",
      "Grep",
      "Read",
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(awk *)",
      "Bash(cat *)",
      "Bash(jq *)",
      "Bash(ls *)",
      "Bash(mkdir *)",
      "Bash(sed *)",
      "Bash(shellcheck *)",
      "Bash(shfmt *)",
      "Bash(which *)",
      "Bash(prek *)",
      "Bash(task *)",
      "Bash(pytest *)",
      "Bash(ruff *)",
      "Bash(uv *)",
      "Bash(biome *)",
      "Bash(bun *)",
      "Bash(eslint *)",
      "Bash(node *)",
      "Bash(npm run *)",
      "Bash(npx *)",
      "Bash(tsc *)",
      "Bash(busted *)",
      "Bash(llscheck *)",
      "Bash(luacheck *)",
      "Bash(cargo *)",
      "Bash(swift *)",
      "Bash(swiftformat *)",
      "Bash(swiftlint *)",
      "Bash(~/.claude/scripts/fix-ci-push.sh *)"
    ],
    "deny": [
      "Bash(git checkout *)",
      "Bash(git checkout)",
      "Bash(git clean *)",
      "Bash(git clean)",
      "Bash(git push *)",
      "Bash(git push)",
      "Bash(git reset *)",
      "Bash(git reset)",
      "Bash(git stash *)",
      "Bash(git stash)",
      "NotebookEdit",
      "Read(.env.*)",
      "Read(.env)",
      "Read(**/*.key)",
      "Read(**/*.pem)",
      "Read(**/*.secret)",
      "Read(**/*credential*)",
      "Read(**/secrets/*)"
    ],
    "defaultMode": "auto"
  },
  "model": "claude-opus-4-6",
  "disableBundledSkills": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/git-lock-guard.sh",
            "if": "Bash(git *)"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/git-guard.sh",
            "if": "Bash(git *)"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/git-commit-guard.sh",
            "if": "Bash(git commit*)"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/marimo-check.sh",
            "if": "Bash(git commit*)"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/shiny-check.sh",
            "if": "Bash(git commit*)"
          }
        ]
      },
      {
        "matcher": "ExitWorktree",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/worktree-guard.sh"
          }
        ]
      },
      {
        "matcher": "EnterPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/plan-skill-guard.sh"
          }
        ]
      },
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/plan-claim-guard.sh"
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/read-once/hook.sh"
          }
        ]
      },
      {
        "matcher": "Read|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/tdd-red-guard.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/collab-reminder.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/collab-reminder.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/bash-exit-guard.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/read-once/compact.sh"
          }
        ]
      }
    ]
  },
  "disableWorkflows": true,
  "statusLine": {
    "type": "command",
    "command": "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/scripts/statusline.sh"
  },
  "enabledPlugins": {
    "lua-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": false,
    "swift-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "clangd-lsp@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    }
  },
  "outputStyle": "Terse",
  "effortLevel": "high",
  "promptSuggestionEnabled": false,
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "autoCompactEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "autoMode": {
    "environment": [
      "### Org-wide",
      "**Organization**: None configured",
      "**Cloud provider(s)**: None configured",
      "**Repository visibility**: Not queryable via gh (org/repo not derivable from origin remote — host `github-personal` is an unsupported/custom SSH alias); assume private per shipped default until confirmed",
      "**Internal sharing / snippet hosting**: None configured — treat public paste/gist services as outside the trust boundary",
      "**Secrets management**: None configured",
      "**Default / protected branches**: main (default branch, per repo facts); protection status not queryable via gh for this remote",
      "**CI/CD deploy targets**: None configured",
      "**Network posture**: None configured",
      "**Source control**: The trusted repo (jeffzi/atc via origin remote `github-personal:jeffzi/atc.git`) and its remote(s) only — no additional orgs configured",
      "**Trusted internal domains**: None configured",
      "**Trusted cloud buckets**: None configured",
      "**Key internal services**: None configured",
      "**Internal package registry**: None configured",
      "**Sensitive data locations & audiences**: any file or store holding personal data, confidential business data, credentials, regulated data, or similarly sensitive material; preserve exact handles when known and share only with audiences cleared at the [named+specifics] bar. Repo has .gitignore patterns for `.env`, `.env.*` (with `!.env.example` carve-out) — treat matching files as sensitive",
      "**Data retention / declassification**: None configured",
      "**Sensitive remote targets**: any namespace, host, or container whose name carries `prod` or `production` as a whole word or name segment",
      "**Protected deployment namespaces / environments**: None configured — fall back to the Sensitive remote targets heuristic",
      "**Protected IaC scopes**: IAM, RBAC, networking, quota, and node-pool resources; anything whose name or tag carries `prod` or `production` as a whole word or name segment",
      "### User-specific",
      "**Primary use of Claude Code**: software development",
      "**Trusted repo**: /Users/jeffzi/Projects/personal/atc (working directory), remote origin at github-personal:jeffzi/atc.git — visibility unconfirmed (assume private per shipped default); confidential material OK there, but content ported from outside this repo is not its own work",
      "**Org-specific CLIs**: None configured"
    ]
  }
}
