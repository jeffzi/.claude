# Ignore everything by default
*

# Allow config files
!.gitignore
!.claudeignore
!.pre-commit-config.yaml
!dprint.json
!.markdownlint-cli2.jsonc
!settings.json
!skills.json
!README.md
!CLAUDE.md

# Allow GitHub config
!.github/
!.github/*
!.github/workflows/
!.github/workflows/**

# Allow scripts
!scripts/
!scripts/**

# Allow skills
!skills/
!skills/**

# Externally synced skills (auto-generated by scripts/sync-skills.sh — do not edit manually)
# SYNC-SKILLS:BEGIN
skills/literature-review/
skills/markdown-mermaid-writing/
skills/paper-lookup/
skills/polars/
skills/pymc/
skills/scikit-learn/
skills/scikit-survival/
skills/statistical-analysis/
skills/statsmodels/
skills/humanizer/
skills/brainstorming/
# SYNC-SKILLS:END

# Allow hooks
!hooks/
!hooks/**

# Allow tests
!tests/
!tests/**

# Allow local marketplace
!local-marketplace/
!local-marketplace/**

# Allow docs
!docs/
!docs/**

# Allow agents
!agents/
!agents/**

# GSD (auto-installed by npx, don't track)
gsd*

# Exclude junk (after whitelist so these take precedence)
.DS_Store
**/*-docs/
**/node_modules/
