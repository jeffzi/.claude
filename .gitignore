# Ignore everything by default
*

# Allow config files
!.gitignore
!.claudeignore
!.pre-commit-config.yaml
!dprint.json
!.markdownlint-cli2.jsonc
!settings.json
!README.md
!CLAUDE.md

# Allow GitHub config
!.github/
!.github/*
!.github/workflows/
!.github/workflows/**

# Allow scripts
!scripts/
!scripts/**

# Allow skills
!skills/
!skills/**

# Externally synced skills (installed by scripts/sync-skills.sh via `npx skills`)
skills/markdown-mermaid-writing/
skills/paper-lookup/
skills/polars/
skills/pymc/
skills/scikit-learn/
skills/scikit-survival/
skills/statistical-analysis/
skills/humanizer/
skills/fallow/

# Allow rules
!rules/
!rules/**

# Allow output styles
!output-styles/
!output-styles/**

# Allow hooks
!hooks/
!hooks/**

# Allow tests
!tests/
!tests/**

# Allow local marketplace
!local-marketplace/
!local-marketplace/**

# Allow docs
!docs/
!docs/**

# Allow agents
!agents/
!agents/**

# Exclude junk (after whitelist so these take precedence)
.DS_Store
**/*-docs/
**/node_modules/
